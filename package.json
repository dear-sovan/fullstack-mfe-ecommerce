{
  "name": "enterprise-ecommerce-root",
  "version": "1.0.0",
  "description": "Enterprise E-Commerce Monorepo with React 18 Module Federation & Express Services",
  "main": "server.js",
  "scripts": {
    "build:all": "node build-all.js",
    "start:be": "npm run dev --prefix services/product-service",
    "start:fe": "wait-port 4001 && node server.js",
    "start": "npm run build:all && concurrently \"npm run start:be\" \"npm run start:fe\""
  },
  "keywords": [
    "micro-frontend",
    "module-federation",
    "react18",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-http-proxy": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.4",
    "open": "^11.0.0",
    "wait-port": "^1.1.0"
  }
}
